---
import { NOW } from '../data/now';
import { formatDateShort } from '../utils/format';

const updated = formatDateShort(new Date(NOW.updated), 'en');
---

<section aria-labelledby="now-heading" class="space-y-6">
  <div>
    <h2 id="now-heading" class="font-mono text-xs font-semibold uppercase tracking-widest text-white/50">
      <span class="text-accent">&gt;</span> Now
    </h2>
    <p class="mt-1 font-mono text-xs text-white/40">Updated {updated}</p>
  </div>

  <div class="space-y-2">
    <h3 class="font-mono text-xs uppercase tracking-widest text-white/40">Doing</h3>
    <ul class="space-y-2 text-sm text-white/80">
      {NOW.doing.map((item) => <li class="border-l border-white/20 pl-3">{item}</li>)}
    </ul>
  </div>

  <div class="space-y-2">
    <h3 class="font-mono text-xs uppercase tracking-widest text-white/40">Projects</h3>
    <ul class="space-y-3 text-sm">
      {
        NOW.projects.map((project) => (
          <li class="border-l border-white/20 pl-3">
            <p class="text-white">{project.name}</p>
            <p class="font-mono text-xs text-accent">{project.status}</p>
            <p class="text-white/50">{project.detail}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
