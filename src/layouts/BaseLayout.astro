---
import '../styles/global.css';
import { SITE_DESCRIPTION, SOCIALS } from '../consts';

interface Props {
  title: string;
  description?: string;
  translations?: { locale: string; url: string }[];
}

const { title, description = SITE_DESCRIPTION, translations } = Astro.props;

const pathname = Astro.url.pathname;
const year = new Date().getFullYear();

const navItems = [
  { label: 'Home', href: '/', current: pathname === '/' },
  { label: 'About', href: '/about', current: pathname.startsWith('/about') },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={title} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/social.png" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="/social.png" />
    {
      translations?.map((t) => (
        <link rel="alternate" hreflang={t.locale} href={t.url} />
      ))
    }
    {
      translations?.some((t) => t.locale === 'en') && (
        <link
          rel="alternate"
          hreflang="x-default"
          href={translations.find((t) => t.locale === 'en')!.url}
        />
      )
    }
    <title>{title}</title>
  </head>
  <body class="flex min-h-screen flex-col bg-black text-white antialiased">
    <header class="fixed inset-x-0 top-0 z-10 border-b border-white/10 bg-black/80 backdrop-blur">
      <div class="mx-auto flex w-full max-w-3xl items-center justify-end px-4 py-3">
        <nav class="flex items-center gap-1 text-sm sm:text-base" aria-label="Main navigation">
          {
            navItems.map((item) => (
              <a
                href={item.href}
                class="rounded-md px-3 py-2 hover:underline"
                aria-current={item.current ? 'page' : undefined}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <main class="w-full flex-1">
      <slot />
    </main>

    <footer class="mt-auto border-t border-white/10">
      <div class="mx-auto flex w-full max-w-3xl flex-col items-center gap-4 px-4 py-6">
        <div class="flex items-center gap-6">
          {
            SOCIALS.map((social) => (
              <a
                href={social.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={social.name}
                class="text-white/60 transition-colors hover:text-white"
              >
                <svg viewBox="0 0 24 24" fill="currentColor" class="h-6 w-6" aria-hidden="true">
                  <path d={social.icon} />
                </svg>
              </a>
            ))
          }
        </div>
        <p class="text-xs text-white/40">&copy; {year} Thalium. All rights reserved.</p>
      </div>
    </footer>
  </body>
</html>
