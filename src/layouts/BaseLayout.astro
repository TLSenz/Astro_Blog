---
import '../styles/global.css';
import { SITE_DESCRIPTION, SITE_TITLE, SITE_URL, SOCIALS } from '../consts';
import NowSidebar from '../components/NowSidebar.astro';
import NotesSidebar from '../components/NotesSidebar.astro';

interface Props {
  title: string;
  description?: string;
  type?: 'website' | 'article';
  translations?: { locale: string; url: string }[];
}

const { title, description = SITE_DESCRIPTION, type = 'website', translations } = Astro.props;

const pathname = Astro.url.pathname;
const year = new Date().getFullYear();
const site = SITE_URL;
const socialImage = new URL('/social.png', site).href;
const canonical = new URL(pathname, site).href;

const navItems = [
  { label: 'Home', href: '/', current: pathname === '/' },
  { label: 'About', href: '/about', current: pathname.startsWith('/about') },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={title} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    {
      translations?.map((t) => (
        <link rel="alternate" hreflang={t.locale} href={t.url} />
      ))
    }
    {
      translations?.some((t) => t.locale === 'en') && (
        <link
          rel="alternate"
          hreflang="x-default"
          href={translations.find((t) => t.locale === 'en')!.url}
        />
      )
    }
    <title>{title}</title>
  </head>
  <body class="flex min-h-screen flex-col bg-black text-white antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-20 focus:rounded-md focus:bg-white/10 focus:px-3 focus:py-2 focus:text-sm focus:text-white"
    >
      Skip to content
    </a>
    <header class="fixed inset-x-0 top-0 z-10 border-b border-white/10 bg-black/80 backdrop-blur">
      <div class="mx-auto flex w-full max-w-3xl items-center justify-between px-4 py-3">
        <a
          href="/"
          class="text-sm font-medium text-white/80 transition-colors hover:text-accent"
        >
          <span class="text-accent">$</span> {SITE_TITLE}
        </a>
        <nav class="flex items-center gap-1 text-sm sm:text-base" aria-label="Main navigation">
          {
            navItems.map((item) => (
              <a
                href={item.href}
                class="rounded-md px-3 py-2 transition-colors hover:text-accent aria-[current=page]:text-accent"
                aria-current={item.current ? 'page' : undefined}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <main id="main" class="w-full flex-1">
      <div class="mx-auto flex w-full max-w-6xl flex-col gap-12 lg:flex-row lg:items-start lg:gap-10">
        <aside class="order-2 w-full px-4 lg:sticky lg:top-24 lg:order-1 lg:w-56 lg:shrink-0 lg:px-0 lg:pt-14">
          <NowSidebar />
        </aside>
        <div class="order-1 min-w-0 flex-1 lg:order-2">
          <slot />
        </div>
        <aside class="order-3 w-full px-4 lg:sticky lg:top-24 lg:w-64 lg:shrink-0 lg:px-0 lg:pt-14">
          <NotesSidebar />
        </aside>
      </div>
    </main>

    <footer class="mt-auto border-t border-white/10">
      <div class="mx-auto flex w-full max-w-3xl flex-col items-center gap-4 px-4 py-6">
        <div class="flex items-center gap-6">
          {
            SOCIALS.map((social) => (
              <a
                href={social.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={social.name}
                class="text-white/60 transition-colors hover:text-white"
              >
                <svg viewBox="0 0 24 24" fill="currentColor" class="h-6 w-6" aria-hidden="true">
                  <path d={social.icon} />
                </svg>
              </a>
            ))
          }
        </div>
        <p class="text-xs text-white/40">&copy; {year} Thalium. All rights reserved.</p>
      </div>
    </footer>
  </body>
</html>
