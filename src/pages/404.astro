---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_TITLE } from '../consts';
---

<BaseLayout title={`Page not found — ${SITE_TITLE}`}>
  <div class="mx-auto w-full max-w-3xl px-4 pt-16 pb-12 text-center sm:pt-32">
    <h1 class="text-3xl font-bold sm:text-5xl">Page not found</h1>
    <p class="mt-3 text-white/70 sm:text-lg">
      The page you're looking for doesn't exist.
    </p>
    <a
      href="/"
      class="mt-6 inline-block rounded-lg bg-white px-4 py-2 font-medium text-black transition-colors hover:bg-white/85"
    >
      &larr; Back to all posts
    </a>
  </div>
</BaseLayout>
